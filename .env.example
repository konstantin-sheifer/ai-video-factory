# Runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DEPLOYMENT_ENVIRONMENT="development"
LOG_LEVEL="info"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
CLERK_SECRET_KEY="sk_test_REPLACE_ME"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Durable queue (disabled until Milestone 2.2D)
QUEUE_ENABLED="false"
REDIS_URL="redis://USER:PASSWORD@HOST:6379"
QUEUE_NAME="ai-video-factory-generation"
QUEUE_PREFIX="aivf"
QUEUE_LEASE_DURATION_MS="60000"
QUEUE_HEARTBEAT_INTERVAL_MS="15000"
QUEUE_WORKER_IDENTITY="worker-local"
QUEUE_WORKER_CONCURRENCY="2"
WORKER_SHUTDOWN_TIMEOUT_MS="30000"
WORKER_RECOVERY_INTERVAL_MS="30000"
WORKER_HEARTBEAT_TTL_MS="45000"

# Provider modes (credentials are intentionally omitted)
AI_BRAIN_LIVE="false"
VIDEO_PROVIDER="mock"
VOICE_PROVIDER="mock"
SUBTITLE_PROVIDER="mock"
RENDER_PROVIDER="mock"
PUBLISH_PROVIDER="mock"
DOWNLOAD_PROVIDER="mock"
PROJECT_STORAGE_PROVIDER="prisma"
